{
  "__inputs": [],
  "__requires": [],
  "title": "ORION — Infrastructure",
  "version": 1,
  "uid": "orion-infrastructure",
  "panels": [
    {
      "title": "Node CPU Usage",
      "type": "graph",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 8},
      "targets": [
        {"expr": "orion:node:cpu_utilization:5m", "legendFormat": "{{ node }}"}
      ],
      "yaxes": [{"format": "percent", "max": 100, "label": "CPU %"}, {"show": false}]
    },
    {
      "title": "Node Memory Usage",
      "type": "graph",
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 8},
      "targets": [
        {"expr": "orion:node:memory_utilization", "legendFormat": "{{ node }}"}
      ],
      "yaxes": [{"format": "percent", "max": 100, "label": "Memory %"}, {"show": false}]
    },
    {
      "title": "Node Disk Usage",
      "type": "graph",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 8},
      "targets": [
        {"expr": "orion:node:disk_utilization", "legendFormat": "{{ node }}"}
      ],
      "yaxes": [{"format": "percent", "max": 100, "label": "Disk %"}, {"show": false}]
    },
    {
      "title": "Network I/O",
      "type": "graph",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(node_network_receive_bytes_total[5m])", "legendFormat": "RX — {{ device }}"},
        {"expr": "rate(node_network_transmit_bytes_total[5m])", "legendFormat": "TX — {{ device }}"}
      ],
      "yaxes": [{"format": "Bps", "label": "Bytes/s"}, {"show": false}]
    },
    {
      "title": "Prometheus Self-Monitoring",
      "type": "stat",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [{"expr": "up{job=\"orion-prometheus\"}"}],
      "options": {"colorMode": "background", "graphMode": "none"}
    }
  ],
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser"
}
