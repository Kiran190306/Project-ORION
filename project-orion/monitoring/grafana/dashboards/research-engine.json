{
  "__inputs": [],
  "__requires": [],
  "title": "ORION — Research Engine",
  "version": 1,
  "uid": "orion-research-engine",
  "panels": [
    {
      "title": "Research Job Rate",
      "type": "graph",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 8},
      "targets": [
        {"expr": "rate(orion_research_jobs_total[5m])", "legendFormat": "Jobs/s"}
      ],
      "yaxes": [{"format": "short", "label": "Jobs/s"}, {"show": false}]
    },
    {
      "title": "Research Error Rate",
      "type": "graph",
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 8},
      "targets": [
        {"expr": "rate(orion_research_jobs_total{status=\"error\"}[5m])", "legendFormat": "Errors/s"}
      ],
      "yaxes": [{"format": "short", "label": "Errors/s"}, {"show": false}]
    },
    {
      "title": "Job Duration (P50 / P95)",
      "type": "graph",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 8},
      "targets": [
        {"expr": "orion:research:job_duration_p50:5m", "legendFormat": "P50"},
        {"expr": "orion:research:job_duration_p95:5m", "legendFormat": "P95"}
      ],
      "yaxes": [{"format": "s", "label": "Duration"}, {"show": false}]
    },
    {
      "title": "Active Jobs",
      "type": "graph",
      "gridPos": {"x": 0, "y": 8, "w": 8, "h": 8},
      "targets": [
        {"expr": "orion:research:active_jobs", "legendFormat": "Active"}
      ],
      "yaxes": [{"format": "short", "label": "Jobs"}, {"show": false}]
    },
    {
      "title": "Queue Depth",
      "type": "graph",
      "gridPos": {"x": 8, "y": 8, "w": 8, "h": 8},
      "targets": [
        {"expr": "orion:research:queue_depth", "legendFormat": "Queue"}
      ],
      "yaxes": [{"format": "short", "label": "Jobs"}, {"show": false}]
    },
    {
      "title": "Research Engine Availability",
      "type": "stat",
      "gridPos": {"x": 16, "y": 8, "w": 8, "h": 8},
      "targets": [{"expr": "up{job=\"orion-research-engine\"}"}],
      "options": {"colorMode": "background", "graphMode": "none"}
    }
  ],
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser"
}
