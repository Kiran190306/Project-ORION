from libraries.domain.ai_research.parameter_stability import ParameterStabilityAnalyzer
from libraries.domain.ai_research.models import WalkForwardResult, WalkForwardWindow


class TestParameterStabilityCoverage:
    """Complete parameter stability coverage."""

    @pytest.mark.asyncio
    async def test_empty_windows_raises(self):
        """No windows raises error."""
        wf = WalkForwardResult(windows=())
        analyzer = ParameterStabilityAnalyzer()
        with pytest.raises(Exception):
            await analyzer.analyze(wf)

    @pytest.mark.asyncio
    async def test_single_window(self):
        """Single window returns stability 1.0."""
        wf = WalkForwardResult(windows=(
            WalkForwardWindow(test_metrics={"sharpe": 1.5, "profit_factor": 2.0}),
        ))
        analyzer = ParameterStabilityAnalyzer()
        report = await analyzer.analyze(wf)
        assert report.stability_score == 1.0

    @pytest.mark.asyncio
    async def test_multiple_windows_stable(self):
        """Stable metrics across windows produce high stability."""
        wf = WalkForwardResult(windows=(
            WalkForwardWindow(test_metrics={"sharpe": 1.5, "profit_factor": 2.0}),
            WalkForwardWindow(test_metrics={"sharpe": 1.6, "profit_factor": 2.1}),
            WalkForwardWindow(test_metrics={"sharpe": 1.4, "profit_factor": 1.9}),
        ))
        analyzer = ParameterStabilityAnalyzer()
        report = await analyzer.analyze(wf)
        assert 0.0 <= report.stability_score <= 1.0
        assert "sharpe" in report.parameter_std
        assert "profit_factor" in report.parameter_std

    @pytest.mark.asyncio
    async def test_multiple_windows_unstable(self):
        """Unstable metrics produce low stability."""
        wf = WalkForwardResult(windows=(
            WalkForwardWindow(test_metrics={"sharpe": 3.0}),
            WalkForwardWindow(test_metrics={"sharpe": 0.1}),
            WalkForwardWindow(test_metrics={"sharpe": -2.0}),
        ))
        analyzer = ParameterStabilityAnalyzer()
        report = await analyzer.analyze(wf)
        assert report.stability_score < 0.95

    @pytest.mark.asyncio
    async def test_zero_mean_values(self):
        """Mean near zero uses absolute values fallback."""
        wf = WalkForwardResult(windows=(
            WalkForwardWindow(test_metrics={"delta": 0.001, "spread": 0.0}),
            WalkForwardWindow(test_metrics={"delta": -0.001, "spread": 0.0}),
        ))
        analyzer = ParameterStabilityAnalyzer()
        report = await analyzer.analyze(wf)
        assert isinstance(report.stability_score, float)

    @pytest.mark.asyncio
    async def test_zero_mean_abs_fallback(self):
        """When both mean and mean_abs are near zero."""
        wf = WalkForwardResult(windows=(
            WalkForwardWindow(test_metrics={"tiny": 1e-8}),
            WalkForwardWindow(test_metrics={"tiny": -1e-8}),
        ))
        analyzer = ParameterStabilityAnalyzer()
        report = await analyzer.analyze(wf)
        assert report.stability_score == 1.0


