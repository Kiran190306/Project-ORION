from libraries.domain.ai_research.market_regime_detector import MarketRegimeDetector


class TestMarketRegimeDetectorCoverage:
    """Complete market regime detector coverage."""

    @pytest.mark.asyncio
    async def test_regime_transition(self):
        """Detect regime from bull market data."""
        close = [100.0 + i * 0.5 for i in range(250)]
        ds = _make_dataset(close)
        detector = MarketRegimeDetector()
        regime = await detector.detect(ds)
        assert isinstance(regime, MarketRegime)

    @pytest.mark.asyncio
    async def test_insufficient_history(self):
        """Few rows raise error."""
        close = [100.0] * 10
        ds = _make_dataset(close)
        detector = MarketRegimeDetector()
        with pytest.raises(Exception):
            await detector.detect(ds)

    @pytest.mark.asyncio
    async def test_classify_full_result(self):
        """classify() returns full MarketClassificationResult."""
        close = [100.0 + i * 0.3 for i in range(250)]
        ds = _make_dataset(close)
        detector = MarketRegimeDetector()
        result = await detector.classify(ds)
        assert result.regime is not None
        assert result.trend is not None
        assert result.volatility is not None
        assert result.liquidity is not None

    @pytest.mark.asyncio
    async def test_conflicting_classifier_outputs(self):
        """Conflicting (bull + low liquidity) handled."""
        close = [100.0 + i * 0.3 for i in range(250)]
        # Very low volume creates low liquidity
        volume = [1.0] * 250
        ds = _make_dataset(close, volume_values=volume)
        detector = MarketRegimeDetector()
        result = await detector.detect(ds)
        assert isinstance(result, MarketRegime)


