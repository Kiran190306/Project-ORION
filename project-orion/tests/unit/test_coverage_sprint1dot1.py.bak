from libraries.domain.ai_research.feature_engineering import (
    CustomFeature,
    FeatureEngineer,
    ResearchFeatureEngineer,
)
from libraries.domain.ai_research.models import FeatureDefinition


class TestFeatureEngineeringCoverage:
    """Complete feature engineering coverage."""

    def test_custom_feature_registration(self):
        """Register a custom feature."""
        engineer = ResearchFeatureEngineer()

        def my_feature(dataset, definition):
            return [1.0] * dataset.row_count

        engineer.register_custom("my_indicator", my_feature)
        assert "my_indicator" in engineer._custom_features

    def test_custom_feature_empty_name_raises(self):
        """Empty name raises error."""
        engineer = ResearchFeatureEngineer()
        with pytest.raises(Exception):
            engineer.register_custom("", lambda d, defn: [1.0])

    def test_custom_feature_non_callable_raises(self):
        """Non-callable raises error."""
        engineer = ResearchFeatureEngineer()
        with pytest.raises(Exception):
            engineer.register_custom("bad", "not_callable")  # type: ignore

    def test_duplicate_registration(self):
        """Duplicate registration overwrites."""
        engineer = ResearchFeatureEngineer()
        def f1(d, defn): return [1.0]
        def f2(d, defn): return [2.0]
        engineer.register_custom("x", f1)
        engineer.register_custom("x", f2)
        assert "x" in engineer._custom_features

    def test_empty_definitions(self):
        """Empty definitions returns empty tuple."""
        ds = _make_dataset([100.0, 101.0])
        import asyncio
        result = asyncio.run(FeatureEngineer.engineer(FeatureEngineer, ds, []))
        assert result == ()

    @pytest.mark.asyncio
    async def test_unsupported_feature(self):
        """Unknown category raises error."""
        ds = _make_dataset([100.0, 101.0])
        defn = FeatureDefinition(name="magic", category="unsupported")
        with pytest.raises(Exception):
            await FeatureEngineer.engineer(FeatureEngineer, ds, [defn])

    @pytest.mark.asyncio
    async def test_missing_required_column(self):
        """Feature missing required column raises error."""
        rows = tuple({"open": 100.0} for _ in range(10))
        ds = ResearchDataset(dataset_id="test", schema=("open",), rows=rows)
        defn = FeatureDefinition(name="sma", category="trend", required_columns=("close",))
        with pytest.raises(Exception):
            await FeatureEngineer.engineer(FeatureEngineer, ds, [defn])

    @pytest.mark.asyncio
    async def test_bollinger_width(self):
        """Bollinger width feature computes correctly."""
        ds = _make_dataset([100.0, 101.0, 102.0, 103.0, 104.0])
        defn = FeatureDefinition(name="bollinger", category="volatility", parameters={"period": 3})
        results = await FeatureEngineer.engineer(FeatureEngineer, ds, [defn])
        assert len(results) == 5

    @pytest.mark.asyncio
    async def test_price_action_return(self):
        """Price action 'return' computes price changes."""
        ds = _make_dataset([100.0, 102.0, 105.0])
        defn = FeatureDefinition(name="return", category="price_action")
        results = await FeatureEngineer.engineer(FeatureEngineer, ds, [defn])
        assert len(results) == 3

    @pytest.mark.asyncio
    async def test_candlestick_range(self):
        """Candlestick range computes high - low."""
        ds = _make_dataset([100.0, 101.0])
        defn = FeatureDefinition(name="range", category="candlestick")
        results = await FeatureEngineer.engineer(FeatureEngineer, ds, [defn])
        assert len(results) == 2

    @pytest.mark.asyncio
    async def test_session_feature(self):
        """Session feature requires timestamp."""
        from datetime import datetime, timezone
        rows = tuple({"close": 100.0, "timestamp": datetime(2024, 1, 15, 10, 0, tzinfo=timezone.utc)} for _ in range(5))
        ds = ResearchDataset(dataset_id="test", schema=("close", "timestamp"), rows=rows)
        defn = FeatureDefinition(name="session", category="session")
        results = await FeatureEngineer.engineer(FeatureEngineer, ds, [defn])
        assert len(results) == 5

    @pytest.mark.asyncio
    async def test_session_no_timestamp_raises(self):
        """Session without timestamp raises error."""
        ds = _make_dataset([100.0, 101.0])
        defn = FeatureDefinition(name="session", category="session")
        with pytest.raises(Exception):
            await FeatureEngineer.engineer(FeatureEngineer, ds, [defn])

    @pytest.mark.asyncio
    async def test_custom_feature_execution(self):
        """Custom feature is executed."""
        engineer = ResearchFeatureEngineer()

        def double_close(dataset, definition):
            return [float(row["close"]) * 2 for row in dataset.rows]

        engineer.register_custom("double", double_close)
        ds = _make_dataset([100.0, 101.0, 102.0])
        defn = FeatureDefinition(name="double", category="custom")
        results = await engineer.engineer(ds, [defn])
        assert len(results) == 3
        assert results[0].values["double"] == 200.0

    @pytest.mark.asyncio
    async def test_custom_feature_not_registered(self):
        """Unregistered custom feature raises error."""
        engineer = ResearchFeatureEngineer()
        ds = _make_dataset([100.0, 101.0])
        defn = FeatureDefinition(name="unregistered", category="custom")
        with pytest.raises(Exception):
            await engineer.engineer(ds, [defn])


