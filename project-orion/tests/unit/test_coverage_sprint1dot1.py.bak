# INTEGRATION
# ==============================================================================

from libraries.observability.integration import (
    ServiceObserver,
    configure_observability,
    observe_service,
)


class DummyService:
    """Simple service for testing."""
    async def run(self, x: int = 0) -> int:
        return x + 1

    async def fail(self) -> None:
        msg = "intentional"
        raise ValueError(msg)

    async def health_check(self) -> dict:
        return {"status": "ok"}

    @property
    def name(self) -> str:
        return "dummy"


class TestIntegrationCoverage:
    """Complete integration coverage."""

    def test_configure_observability_defaults(self):
        """configure_observability sets global defaults."""
        configure_observability(service_name="test-svc", service_version="1.0.0", environment="testing")
        # No crash

    def test_configure_observability_with_registries(self):
        """configure_observability with metrics and tracing."""
        from libraries.observability.metrics import MetricsRegistry
        from libraries.observability.tracing import TracingManager
        configure_observability(
            service_name="full",
            metrics_registry=MetricsRegistry(),
            tracing_manager=TracingManager(),
        )

    @pytest.mark.asyncio
    async def test_observe_service_success(self):
        """Decorated async method returns correct result."""
        svc = DummyService()

        @observe_service("dummy.run")
        async def run():
            return await svc.run(5)

        result = await run()
        assert result == 6

    @pytest.mark.asyncio
    async def test_observe_service_exception(self):
        """Decorated async method propagates exception."""
        svc = DummyService()

        @observe_service("dummy.fail")
        async def run():
            await svc.fail()

        with pytest.raises(ValueError):
            await run()

    @pytest.mark.asyncio
    async def test_observe_service_no_tracing(self):
        """Decorator works with tracing disabled."""
        @observe_service("test", metrics=False, tracing=False, logging_enabled=False)
        async def simple() -> str:
            return "ok"

        result = await simple()
        assert result == "ok"

    @pytest.mark.asyncio
    async def test_service_observer_wraps(self):
        """ServiceObserver proxies method calls."""
        svc = DummyService()
        observed = ServiceObserver(svc, "dummy", metrics_enabled=False, tracing_enabled=False, logging_enabled=False)
        result = await observed.run(3)
        assert result == 4

    @pytest.mark.asyncio
    async def test_service_observer_health(self):
        """ServiceObserver.health() delegates to service."""
        svc = DummyService()
        observed = ServiceObserver(svc, "dummy", metrics_enabled=False, tracing_enabled=False, logging_enabled=False)
        health = await observed.health()
        assert health["service"] == "dummy"
        assert health["observed"] is True
        assert health["status"] == "ok"

    @pytest.mark.asyncio
    async def test_service_observer_health_alias(self):
        """health_check is alias for health."""
        svc = DummyService()
        observed = ServiceObserver(svc, "dummy")
        h1 = await observed.health()
        h2 = await observed.health_check()
        assert h1["service"] == h2["service"]

    @pytest.mark.asyncio
    async def test_service_observer_health_without_method(self):
        """health works even if service lacks health_check."""

        class NoHealthService:
            async def run(self) -> int:
                return 1

        observed = ServiceObserver(NoHealthService(), "no-health")
        health = await observed.health()
        assert "health_error" not in health

    @pytest.mark.asyncio
    async def test_service_observer_health_exception(self):
        """health handles exceptions in service health_check."""

        class BrokenService:
            async def health_check(self) -> dict:
                msg = "broken"
                raise RuntimeError(msg)

        observed = ServiceObserver(BrokenService(), "broken")
        health = await observed.health()
        assert health["health_error"] is not None

    def test_service_observer_wrapped_property(self):
        """wrapped property returns underlying service."""
        svc = DummyService()
        observed = ServiceObserver(svc, "dummy")
        assert observed.wrapped is svc

    def test_service_observer_getattr_non_callable(self):
        """Non-callable attributes pass through."""
        svc = DummyService()
        observed = ServiceObserver(svc, "dummy")
        assert observed.name == "dummy"


# ==============================================================================
# LOGGING
# ==============================================================================

from libraries.observability.logging import (
    StructuredFormatter,
    StructuredLogger,
    configure_logging,
    get_logger,
    get_correlation_id,
    set_correlation_id as set_cid,
    set_trace_ids as set_tids,
)
from libraries.observability.config import LoggingConfig


class TestLoggingCoverage:
    """Complete logging coverage."""

    def test_set_get_correlation_id(self):
        set_cid("abc123")
        assert get_correlation_id() == "abc123"

    def test_trace_ids(self):
        set_tids("trace1", "span1")
        # No explicit getter, but shouldn't crash

    def test_get_logger_reuses(self):
        l1 = get_logger("test.logger")
        l2 = get_logger("test.logger")
        assert l1 is l2

    def test_logger_name(self):
        logger = get_logger("my.service")
        assert logger.name == "my.service"

    def test_configure_logging_default(self):
        config = LoggingConfig(level="debug", enable_console=True, enable_file=False)
        configure_logging(config)
        # Should not raise

    def test_logger_level_methods(self):
        logger = get_logger("test.levels")
        logger.debug("debug msg", key="val")
        logger.info("info msg", key="val")
        logger.warning("warn msg", key="val")
        logger.error("error msg", key="val")
        logger.critical("critical msg", key="val")
        # Should not raise

    def test_logger_exception(self):
        logger = get_logger("test.exception")
        try:
            msg = "oops"
            raise ValueError(msg)
        except ValueError:
            logger.exception("exception occurred", key="val")

    def test_formatter_json(self):
        config = LoggingConfig(level="debug")
        fmt = StructuredFormatter(config)
        import logging
        record = logging.LogRecord(
            name="test", level=logging.INFO, pathname=__file__,
            lineno=42, msg="hello %s", args=("world",), exc_info=None,
        )
        output = fmt.format(record)
        parsed = json.loads(output)
        assert parsed["message"] == "hello world"
        assert parsed["level"] == "INFO"
        assert parsed["logger"] == "test"

    def test_formatter_exc_info_tuple(self):
        config = LoggingConfig(level="debug")
        fmt = StructuredFormatter(config)
        import logging, sys
        try:
            msg = "fail"
            raise RuntimeError(msg)
        except RuntimeError:
            exc_info = sys.exc_info()
        record = logging.LogRecord(
            name="test", level=logging.ERROR, pathname=__file__,
            lineno=42, msg="error", args=(), exc_info=exc_info,
        )
        output = fmt.format(record)
        parsed = json.loads(output)
        assert "exception" in parsed
        assert parsed["exception"]["type"] == "RuntimeError"

    def test_formatter_exc_text(self):
        config = LoggingConfig(level="debug")
        fmt = StructuredFormatter(config)
        import logging
        record = logging.LogRecord(
            name="test", level=logging.ERROR, pathname=__file__,
            lineno=42, msg="error", args=(), exc_info=None,
        )
        record.exc_text = "Traceback: simulated"
        output = fmt.format(record)
        parsed = json.loads(output)
        assert "exception" in parsed
        assert parsed["exception"]["text"] == "Traceback: simulated"

    def test_formatter_exc_info_true(self):
        """exc_info=True is handled (Python 3.14 regression)."""
        config = LoggingConfig(level="debug")
        fmt = StructuredFormatter(config)
        import logging
        record = logging.LogRecord(
            name="test", level=logging.ERROR, pathname=__file__,
            lineno=42, msg="error", args=(), exc_info=True,
        )
        output = fmt.format(record)
        parsed = json.loads(output)
        assert "exception" in parsed
        assert parsed["exception"]["resolved"] is True

    def test_formatter_sensitive_masking(self):
        config = LoggingConfig(
            level="debug",
            sensitive_fields=["password", "api_key", "secret"],
        )
        fmt = StructuredFormatter(config)
        import logging
        record = logging.LogRecord(
            name="test", level=logging.INFO, pathname=__file__,
            lineno=42, msg="login attempt", args=(), exc_info=None,
        )
        record.extra_fields = {"password": "secret123", "api_key": "abc", "user": "admin"}
        output = fmt.format(record)
        parsed = json.loads(output)
        assert parsed["password"] == "***REDACTED***"
        assert parsed["api_key"] == "***REDACTED***"
        assert parsed["user"] == "admin"

    def test_formatter_includes_metadata(self):
        config = LoggingConfig(service_name="test-svc", environment="test-env")
        fmt = StructuredFormatter(config)
        import logging
        record = logging.LogRecord(
            name="meta", level=logging.INFO, pathname=__file__,
            lineno=42, msg="meta test", args=(), exc_info=None,
        )
        output = fmt.format(record)
        parsed = json.loads(output)
        assert parsed["service"] == "test-svc"
        assert parsed["environment"] == "test-env"
        assert parsed["module"] == "test_coverage_sprint1dot1"

    def test_formatter_nested_exception(self):
        """Nested exceptions are handled."""
        config = LoggingConfig(level="debug")
        fmt = StructuredFormatter(config)
        import logging, sys
        try:
            try:
                msg = "inner"
                raise ValueError(msg)
            except ValueError as inner:
                msg2 = "outer"
                raise RuntimeError(msg2) from inner
        except RuntimeError:
            exc_info = sys.exc_info()
        record = logging.LogRecord(
            name="nested", level=logging.ERROR, pathname=__file__,
            lineno=42, msg="nested error", args=(), exc_info=exc_info,
        )
        output = fmt.format(record)
        parsed = json.loads(output)
        assert "exception" in parsed


# ==============================================================================
# MARKET CLASSIFIER
# ==============================================================================

from libraries.domain.ai_research.market_classifier import MarketClassifier
from libraries.domain.ai_research.models import (
    LiquidityLevel,
    MarketCondition,
    MarketRegime,
    ResearchDataset,
    TrendDirection,
    VolatilityLevel,
)


def _make_dataset(close_values, high_values=None, low_values=None, volume_values=None):
    high = high_values or [c * 1.01 for c in close_values]
    low = low_values or [c * 0.99 for c in close_values]
    volume = volume_values or [1000.0] * len(close_values)
    rows = []
    for i in range(len(close_values)):
        row = {
            "close": close_values[i],
            "high": high[i] if i < len(high) else close_values[i] * 1.01,
            "low": low[i] if i < len(low) else close_values[i] * 0.99,
            "volume": volume[i] if i < len(volume) else 1000.0,
        }
        rows.append(row)
    schema = ("close", "high", "low", "volume")
    return ResearchDataset(dataset_id="test", schema=schema, rows=tuple(rows))


class TestMarketClassifierCoverage:
    """Complete market classifier coverage."""

    @pytest.mark.asyncio
    async def test_bull_market(self):
        """Bull trend: rising close prices, fast SMA > slow SMA."""
        # 250 rising values for SMA(200) to work
        close = [100.0 + i * 0.5 for i in range(250)]
        ds = _make_dataset(close)
        classifier = MarketClassifier()
        result = await classifier.classify(ds)
        assert result.condition in (MarketCondition.BULL, MarketCondition.MIXED)

    @pytest.mark.asyncio
    async def test_bear_market(self):
        """Bear trend: falling close prices."""
        close = [200.0 - i * 0.5 for i in range(250)]
        ds = _make_dataset(close)
        classifier = MarketClassifier()
        result = await classifier.classify(ds)
        assert result.condition in (MarketCondition.BEAR, MarketCondition.MIXED)

    @pytest.mark.asyncio
    async def test_sideways_market(self):
        """Sideways: prices oscillate in a narrow range."""
        import math
        close = [100.0 + math.sin(i * 0.1) * 2.0 for i in range(250)]
        ds = _make_dataset(close)
        classifier = MarketClassifier()
        result = await classifier.classify(ds)
        assert result.regime in (MarketRegime.RANGING, MarketRegime.UNKNOWN)
        assert isinstance(result.confidence, float)

    @pytest.mark.asyncio
    async def test_mixed_signals(self):
        """Mixed: bull trend + high volatility."""
        close = [100.0 + i * 0.3 + (i % 10) * 5.0 for i in range(250)]
        ds = _make_dataset(close)
        classifier = MarketClassifier()
        result = await classifier.classify(ds)
        assert isinstance(result.condition, MarketCondition)

    @pytest.mark.asyncio
    async def test_low_sample_count(self):
        """Fewer rows than SMA(200) threshold raises error."""
        close = [100.0] * 50
        ds = _make_dataset(close)
        classifier = MarketClassifier()
        with pytest.raises(Exception):
            await classifier.classify(ds)

    @pytest.mark.asyncio
    async def test_missing_indicators(self):
        """Dataset missing 'high' column raises error."""
        rows = tuple({"close": 100.0} for _ in range(10))
        ds = ResearchDataset(dataset_id="test", schema=("close",), rows=rows)
        classifier = MarketClassifier()
        with pytest.raises(Exception):
            await classifier.classify(ds)

    @pytest.mark.asyncio
    async def test_regime_resolution(self):
        """_resolve_regime maps to correct MarketRegime."""
        from libraries.domain.ai_research.models import (
            LiquidityClassificationResult,
            TrendClassificationResult,
            VolatilityClassificationResult,
        )

        trend = TrendClassificationResult(direction=TrendDirection.BULL, strength=0.8, slope=0.01)
        vol = VolatilityClassificationResult(level=VolatilityLevel.NORMAL, percentile=0.5, atr_value=1.0)
        liq = LiquidityClassificationResult(level=LiquidityLevel.HIGH, score=0.9, avg_volume=10000)
        regime = MarketClassifier._resolve_regime(trend, vol, liq)
        assert regime == MarketRegime.TRENDING

    @pytest.mark.asyncio
    async def test_regime_high_volatility(self):
        """High volatility maps to HIGH_VOLATILITY regime."""
        from libraries.domain.ai_research.models import (
            LiquidityClassificationResult,
            TrendClassificationResult,
            VolatilityClassificationResult,
        )
        trend = TrendClassificationResult(direction=TrendDirection.SIDEWAYS, strength=0.3, slope=0.0)
        vol = VolatilityClassificationResult(level=VolatilityLevel.HIGH, percentile=0.9, atr_value=5.0)
        liq = LiquidityClassificationResult(level=LiquidityLevel.HIGH, score=0.9, avg_volume=10000)
        regime = MarketClassifier._resolve_regime(trend, vol, liq)
        assert regime == MarketRegime.HIGH_VOLATILITY

    @pytest.mark.asyncio
    async def test_regime_low_liquidity(self):
        """Low liquidity maps to LOW_LIQUIDITY regime."""
        from libraries.domain.ai_research.models import (
            LiquidityClassificationResult,
            TrendClassificationResult,
            VolatilityClassificationResult,
        )
        trend = TrendClassificationResult(direction=TrendDirection.SIDEWAYS, strength=0.3, slope=0.0)
        vol = VolatilityClassificationResult(level=VolatilityLevel.NORMAL, percentile=0.5, atr_value=1.0)
        liq = LiquidityClassificationResult(level=LiquidityLevel.LOW, score=0.2, avg_volume=100)
        regime = MarketClassifier._resolve_regime(trend, vol, liq)
        assert regime == MarketRegime.LOW_LIQUIDITY

    @pytest.mark.asyncio
    async def test_condition_unknown(self):
        """Fully unknown returns UNKNOWN condition."""
        from libraries.domain.ai_research.models import (
            LiquidityClassificationResult,
            TrendClassificationResult,
            VolatilityClassificationResult,
        )
        trend = TrendClassificationResult(direction=TrendDirection.UNKNOWN, strength=0.0, slope=0.0)
        vol = VolatilityClassificationResult(level=VolatilityLevel.NORMAL, percentile=0.5, atr_value=1.0)
        liq = LiquidityClassificationResult(level=LiquidityLevel.NORMAL, score=0.5, avg_volume=1000)
        condition = MarketClassifier._resolve_condition(trend, vol, liq)
        assert condition == MarketCondition.UNKNOWN


