"""Coverage completion tests for EPIC-012 Sprint-1.1.

Target modules:
- middleware.py, health.py, integration.py, logging.py (observability)
- market_classifier.py, market_regime_detector.py, parameter_stability.py
- feature_engineering.py, fitness_engine.py, grid_search.py
"""

from __future__ import annotations

import json
import uuid
from datetime import datetime, timezone
from unittest.mock import AsyncMock, MagicMock, patch

import pytest

# ==============================================================================
# MIDDLEWARE (existing file: test_observability_middleware.py was truncated)
# ==============================================================================

from libraries.observability.logging import set_correlation_id, set_trace_ids
from libraries.observability.middleware import (
    CorrelationIdMiddleware,
    ObservabilityMiddleware,
    RequestMetricsMiddleware,
)
from libraries.observability.metrics import MetricsRegistry


@pytest.fixture
def registry():
    return MetricsRegistry()


@pytest.fixture
def ok_app():
    async def app(scope, receive, send):
        await send({"type": "http.response.start", "status": 200})
        await send({"type": "http.response.body", "body": b"ok"})
    return app


@pytest.fixture
def fail_app():
    async def app(scope, receive, send):
        msg = "boom"
        raise RuntimeError(msg)
    return app


class TestMiddlewareFull:
    """Complete middleware test coverage."""

    @pytest.mark.asyncio
    async def test_observability_request_lifecycle(self, ok_app, registry):
        """Request lifecycle: start -> response -> body."""
        mw = ObservabilityMiddleware(ok_app, metrics_registry=registry)
        scope = {"type": "http", "method": "GET", "path": "/api/test", "headers": {}}
        await mw(scope, AsyncMock(), AsyncMock())

    @pytest.mark.asyncio
    async def test_observability_websocket_passthrough(self, ok_app, registry):
        """WebSocket scope passes through."""
        mw = ObservabilityMiddleware(ok_app, metrics_registry=registry)
        await mw({"type": "websocket"}, AsyncMock(), AsyncMock())

    @pytest.mark.asyncio
    async def test_observability_excluded_path(self, ok_app, registry):
        """Excluded paths skip observability."""
        mw = ObservabilityMiddleware(ok_app, metrics_registry=registry)
        scope = {"type": "http", "method": "GET", "path": "/health", "headers": {}}
        await mw(scope, AsyncMock(), AsyncMock())

    @pytest.mark.asyncio
    async def test_observability_exception(self, fail_app, registry):
        """Exceptions are re-raised."""
        mw = ObservabilityMiddleware(fail_app, metrics_registry=registry)
        scope = {"type": "http", "method": "GET", "path": "/api/test", "headers": {}}
        with pytest.raises(RuntimeError):
            await mw(scope, AsyncMock(), AsyncMock())

    @pytest.mark.asyncio
    async def test_observability_no_metrics(self, ok_app):
        """Works without metrics registry."""
        mw = ObservabilityMiddleware(ok_app)
        scope = {"type": "http", "method": "GET", "path": "/api/test", "headers": {}}
        await mw(scope, AsyncMock(), AsyncMock())

    @pytest.mark.asyncio
    async def test_observability_disabled_tracer(self, ok_app):
        """Disabled tracer doesn't create spans."""
        from libraries.observability.tracing import TracingManager
        tracer = TracingManager()
        mw = ObservabilityMiddleware(ok_app, tracer=tracer)
        scope = {"type": "http", "method": "GET", "path": "/api/test", "headers": {}}
        await mw(scope, AsyncMock(), AsyncMock())
        assert len(tracer.get_spans()) == 0

    @pytest.mark.asyncio
    async def test_observability_enabled_tracer(self, ok_app):
        """Enabled tracer creates spans."""
        from libraries.observability.tracing import TracingManager
        tracer = TracingManager()
        tracer.enable()
        mw = ObservabilityMiddleware(ok_app, tracer=tracer)
        scope = {"type": "http", "method": "POST", "path": "/api/data", "headers": {}}
        await mw(scope, AsyncMock(), AsyncMock())
        assert len(tracer.get_spans()) > 0

    @pytest.mark.asyncio
    async def test_observability_correlation_header(self, ok_app, registry):
        """Correlation ID from header is used."""
        corr = uuid.uuid4().hex
        mw = ObservabilityMiddleware(ok_app, metrics_registry=registry)
        scope = {"type": "http", "method": "GET", "path": "/api/test", "headers": {"x-correlation-id": corr}}
        await mw(scope, AsyncMock(), AsyncMock())

    @pytest.mark.asyncio
    async def test_observability_metrics_recorded(self, ok_app, registry):
        """Metrics are recorded after successful request."""
        mw = ObservabilityMiddleware(ok_app, metrics_registry=registry)
        scope = {"type": "http", "method": "GET", "path": "/api/test", "headers": {}}
        await mw(scope, AsyncMock(), AsyncMock())
        assert len(registry.snapshot()) > 0

    @pytest.mark.asyncio
    async def test_correlation_websocket(self, ok_app):
        """CorrelationIdMiddleware passes websocket through."""
        mw = CorrelationIdMiddleware(ok_app)
        await mw({"type": "websocket"}, AsyncMock(), AsyncMock())

    @pytest.mark.asyncio
    async def test_correlation_missing_header(self, ok_app):
        """CorrelationIdMiddleware generates ID when header missing."""
        mw = CorrelationIdMiddleware(ok_app)
        scope = {"type": "http", "method": "GET", "path": "/api", "headers": {}}
        await mw(scope, AsyncMock(), AsyncMock())

    @pytest.mark.asyncio
    async def test_correlation_exception_clears(self, fail_app):
        """CorrelationIdMiddleware clears ID on exception."""
        mw = CorrelationIdMiddleware(fail_app)
        scope = {"type": "http", "method": "GET", "path": "/api", "headers": {}}
        with pytest.raises(RuntimeError):
            await mw(scope, AsyncMock(), AsyncMock())

    @pytest.mark.asyncio
    async def test_metrics_websocket(self, ok_app, registry):
        """RequestMetricsMiddleware passes websocket through."""
        mw = RequestMetricsMiddleware(ok_app, registry)
        await mw({"type": "websocket"}, AsyncMock(), AsyncMock())

    @pytest.mark.asyncio
    async def test_metrics_excluded_path(self, ok_app, registry):
        """RequestMetricsMiddleware skips excluded paths."""
        mw = RequestMetricsMiddleware(ok_app, registry)
        scope = {"type": "http", "method": "GET", "path": "/health", "headers": {}}
        await mw(scope, AsyncMock(), AsyncMock())


# ==============================================================================
# HEALTH CHECK
# ==============================================================================

from libraries.observability.health import (
    HealthCheckResult,
    HealthRegistry,
    HealthStatus,
)


class TestHealthCoverage:
    """Complete health check coverage."""

    def test_health_status_values(self):
        assert HealthStatus.HEALTHY.value == "healthy"
        assert HealthStatus.DEGRADED.value == "degraded"
        assert HealthStatus.UNHEALTHY.value == "unhealthy"

    def test_health_check_result_defaults(self):
        r = HealthCheckResult(name="test", status=HealthStatus.HEALTHY)
        assert r.message == ""
        assert r.duration_ms == 0.0
        assert r.details == {}

    def test_health_check_result_to_dict(self):
        r = HealthCheckResult(name="cpu", status=HealthStatus.DEGRADED, message="high load")
        d = r.to_dict()
        assert d["name"] == "cpu"
        assert d["status"] == "degraded"
        assert d["message"] == "high load"

    def test_health_check_result_frozen(self):
        r = HealthCheckResult(name="mem", status=HealthStatus.HEALTHY)
        with pytest.raises(AttributeError):
            r.name = "other"  # type: ignore[misc]

    def test_disk_space_healthy(self):
        check = HealthRegistry.disk_space(path="/", threshold_mb=0.0)
        result = check()
        assert isinstance(result, HealthCheckResult)
        assert result.status in (HealthStatus.HEALTHY, HealthStatus.DEGRADED)

    def test_disk_space_invalid_path(self):
        check = HealthRegistry.disk_space(path="/nonexistent_path_xyz", threshold_mb=100.0)
        result = check()
        assert result.status == HealthStatus.UNHEALTHY

    def test_memory_available_healthy(self):
        check = HealthRegistry.memory_available(threshold_mb=0.0)
        result = check()
        assert isinstance(result, HealthCheckResult)

    def test_register_liveness(self):
        reg = HealthRegistry()
        reg.register_liveness("app", HealthRegistry.app_alive("app"))
        results = reg._liveness_checks
        assert "app" in results

    def test_register_readiness(self):
        reg = HealthRegistry()
        reg.register_readiness("db", lambda: HealthCheckResult(name="db", status=HealthStatus.HEALTHY))
        assert "db" in reg._readiness_checks

    def test_register_startup(self):
        reg = HealthRegistry()
        reg.register_startup("cache", lambda: HealthCheckResult(name="cache", status=HealthStatus.HEALTHY))
        assert "cache" in reg._startup_checks

    @pytest.mark.asyncio
    async def test_check_liveness(self):
        reg = HealthRegistry()
        reg.register_liveness("app", HealthRegistry.app_alive("app"))
        results = await reg.check_liveness()
        assert len(results) == 1
        assert results[0].status == HealthStatus.HEALTHY

    @pytest.mark.asyncio
    async def test_check_readiness(self):
        reg = HealthRegistry()
        reg.register_readiness("db", lambda: HealthCheckResult(name="db", status=HealthStatus.HEALTHY))
        results = await reg.check_readiness()
        assert len(results) == 1

    @pytest.mark.asyncio
    async def test_check_startup(self):
        reg = HealthRegistry()
        reg.register_startup("init", lambda: HealthCheckResult(name="init", status=HealthStatus.HEALTHY))
        results = await reg.check_startup()
        assert len(results) == 1

    @pytest.mark.asyncio
    async def test_check_all_healthy(self):
        reg = HealthRegistry()
        reg.register_liveness("app", HealthRegistry.app_alive())
        report = await reg.check_all()
        assert report["status"] == "healthy"

    @pytest.mark.asyncio
    async def test_check_all_unhealthy(self):
        reg = HealthRegistry()
        reg.register_readiness("fail", lambda: HealthCheckResult(name="fail", status=HealthStatus.UNHEALTHY, message="fail"))
        report = await reg.check_all()
        assert report["status"] == "unhealthy"

    @pytest.mark.asyncio
    async def test_check_all_degraded(self):
        reg = HealthRegistry()
        reg.register_liveness("app", HealthRegistry.app_alive())
        reg.register_readiness("slow", lambda: HealthCheckResult(name="slow", status=HealthStatus.DEGRADED, message="slow"))
        report = await reg.check_all()
        assert report["status"] == "degraded"

    @pytest.mark.asyncio
    async def test_timeout_check(self):
        """Check that exceptions in checks are caught."""
        reg = HealthRegistry()

        def failing():
            msg = "timeout"
            raise TimeoutError(msg)

        reg.register_liveness("timeout", failing)
        results = await reg.check_liveness()
        assert results[0].status == HealthStatus.UNHEALTHY
        assert "timeout" in results[0].message.lower()

    @pytest.mark.asyncio
    async def test_async_check(self):
        """Async health check functions are supported."""
        reg = HealthRegistry()

        async def async_check() -> HealthCheckResult:
            return HealthCheckResult(name="async", status=HealthStatus.HEALTHY)

        reg.register_readiness("async", async_check)
        results = await reg.check_readiness()
        assert results[0].status == HealthStatus.HEALTHY

    @pytest.mark.asyncio
    async def test_non_health_result_defaults(self):
        """Non-HealthCheckResult return values default to healthy."""
        reg = HealthRegistry()
        reg.register_liveness("weird", lambda: "not_a_result")
        results = await reg.check_liveness()
        assert results[0].status == HealthStatus.HEALTHY


