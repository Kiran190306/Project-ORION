from libraries.domain.ai_research.fitness_engine import CompositeFitnessEngine
from libraries.domain.ai_research.models import FitnessWeights, StrategyEvaluation


class TestFitnessEngineCoverage:
    """Complete fitness engine coverage."""

    def test_weight_validation(self):
        """Custom weights are used."""
        w = FitnessWeights(sharpe=0.5, profit_factor=0.3)
        engine = CompositeFitnessEngine(weights=w)
        assert engine.weights.sharpe == 0.5

    def test_empty_metrics_raises(self):
        """Empty metrics raises error."""
        engine = CompositeFitnessEngine()
        eval_ = StrategyEvaluation(strategy_id="s1", dataset_id="d1", metrics={})
        with pytest.raises(Exception):
            engine.calculate(eval_)

    def test_valid_calculation(self):
        """Valid metrics produce composite score."""
        engine = CompositeFitnessEngine()
        eval_ = StrategyEvaluation(
            strategy_id="s1",
            dataset_id="d1",
            metrics={"sharpe": 1.5, "profit_factor": 2.0, "win_rate": 0.6, "expectancy": 0.1},
        )
        result = engine.calculate(eval_)
        assert result.composite_score > 0
        assert "sharpe" in result.component_scores

    def test_calmar_ratio_no_risk_free(self):
        """Calmar ratio without risk-free rate."""
        engine = CompositeFitnessEngine()
        eval_ = StrategyEvaluation(
            strategy_id="s1",
            dataset_id="d1",
            metrics={"calmar": 2.0, "sharpe": 1.0, "profit_factor": 1.5, "win_rate": 0.5, "expectancy": 0.05},
        )
        result = engine.calculate(eval_)
        assert result.composite_score != 0

    def test_zero_division(self):
        """Zero values are handled gracefully."""
        engine = CompositeFitnessEngine()
        eval_ = StrategyEvaluation(
            strategy_id="s1",
            dataset_id="d1",
            metrics={"sharpe": 0.0, "profit_factor": 1.0, "win_rate": 0.0, "expectancy": 0.0},
        )
        result = engine.calculate(eval_)
        assert isinstance(result.composite_score, float)

    def test_negative_returns(self):
        """Negative metrics produce lower score."""
        engine = CompositeFitnessEngine()
        eval_ = StrategyEvaluation(
            strategy_id="s1",
            dataset_id="d1",
            metrics={"sharpe": -2.0, "profit_factor": 0.5, "win_rate": 0.3, "expectancy": -0.1},
        )
        result = engine.calculate(eval_)
        assert result.composite_score < 0

    def test_extreme_drawdown(self):
        """Extreme drawdown is capped."""
        engine = CompositeFitnessEngine()
        eval_ = StrategyEvaluation(
            strategy_id="s1",
            dataset_id="d1",
            metrics={
                "sharpe": 1.0, "profit_factor": 2.0, "win_rate": 0.6,
                "expectancy": 0.1, "max_drawdown": -90.0,
            },
        )
        result = engine.calculate(eval_)
        assert isinstance(result.composite_score, float)

    def test_nan_handling(self):
        """NaN values are clamped to 0."""
        import math
        engine = CompositeFitnessEngine()
        eval_ = StrategyEvaluation(
            strategy_id="s1",
            dataset_id="d1",
            metrics={"sharpe": float("nan"), "profit_factor": 2.0, "win_rate": 0.6, "expectancy": 0.1},
        )
        result = engine.calculate(eval_)
        assert isinstance(result.composite_score, float)

    def test_infinite_values(self):
        """Infinite values are clamped."""
        import math
        engine = CompositeFitnessEngine()
        eval_ = StrategyEvaluation(
            strategy_id="s1",
            dataset_id="d1",
            metrics={"sharpe": float("inf"), "profit_factor": 2.0, "win_rate": 0.6, "expectancy": 0.1},
        )
        result = engine.calculate(eval_)
        assert isinstance(result.composite_score, float)

    def test_batch_calculation(self):
        """Batch calculation returns tuple."""
        engine = CompositeFitnessEngine()
        evals = (
            StrategyEvaluation(strategy_id="s1", dataset_id="d1", metrics={"sharpe": 1.0, "profit_factor": 1.5, "win_rate": 0.5, "expectancy": 0.05}),
            StrategyEvaluation(strategy_id="s2", dataset_id="d1", metrics={"sharpe": 0.5, "profit_factor": 1.2, "win_rate": 0.4, "expectancy": 0.02}),
        )
        results = engine.calculate_batch(evals)
        assert len(results) == 2


