from libraries.domain.ai_research.grid_search import GridSearchOptimizer
from libraries.domain.ai_research.models import (
    OptimizationState,
    ParameterConstraint,
    ParameterDefinition,
    ParameterSpace,
    ParameterType,
)


def _make_int_param(name: str, min_v: int, max_v: int) -> ParameterDefinition:
    return ParameterDefinition(
        name=name,
        parameter_type=ParameterType.INT,
        constraint=ParameterConstraint(min_value=min_v, max_value=max_v, step=1),
    )


class TestGridSearchCoverage:
    """Complete grid search coverage."""

    def test_empty_parameter_space_raises(self):
        """Empty space raises error."""
        space = ParameterSpace(parameters=())
        optimizer = GridSearchOptimizer()
        with pytest.raises(Exception):
            optimizer.generate(space)

    def test_single_parameter(self):
        """Single parameter generates correct count."""
        space = ParameterSpace(parameters=(_make_int_param("x", 1, 3),))
        optimizer = GridSearchOptimizer()
        results = optimizer.generate(space)
        assert len(results) == 3
        assert optimizer.state == OptimizationState.COMPLETED

    def test_multiple_parameters(self):
        """Multiple parameters generate Cartesian product."""
        space = ParameterSpace(parameters=(
            _make_int_param("a", 1, 2),
            _make_int_param("b", 10, 11),
        ))
        optimizer = GridSearchOptimizer()
        results = optimizer.generate(space)
        assert len(results) == 4  # 2 * 2

    def test_max_combinations_limit(self):
        """Max combinations cap is respected."""
        space = ParameterSpace(parameters=(_make_int_param("x", 1, 100),))
        optimizer = GridSearchOptimizer()
        results = optimizer.generate(space, max_combinations=10)
        assert len(results) == 10

    def test_cancellation(self):
        """Cancellation stops generation."""
        space = ParameterSpace(parameters=(_make_int_param("x", 1, 1000),))
        optimizer = GridSearchOptimizer()
        optimizer.cancel()
        assert optimizer.state == OptimizationState.CANCELLED
        results = optimizer.generate(space)
        assert len(results) == 0

    def test_progress_callback(self):
        """Progress callback is invoked."""
        calls = []

        def callback(report):
            calls.append(report)

        space = ParameterSpace(parameters=(_make_int_param("x", 1, 100),))
        optimizer = GridSearchOptimizer()
        results = optimizer.generate(space, progress_callback=callback)
        assert len(calls) > 0
        assert len(results) == 100

    def test_float_parameter(self):
        """Float parameter values."""
        param = ParameterDefinition(
            name="rate",
            parameter_type=ParameterType.FLOAT,
            constraint=ParameterConstraint(min_value=0.0, max_value=1.0, step=0.5),
        )
        space = ParameterSpace(parameters=(param,))
        optimizer = GridSearchOptimizer()
        results = optimizer.generate(space)
        assert len(results) == 3  # 0.0, 0.5, 1.0

    def test_decimal_parameter(self):
        """Decimal parameter values."""
        from decimal import Decimal
        param = ParameterDefinition(
            name="price",
            parameter_type=ParameterType.DECIMAL,
            constraint=ParameterConstraint(values=[Decimal("10.0"), Decimal("20.0")]),
        )
