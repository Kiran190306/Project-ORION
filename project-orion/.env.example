# ══════════════════════════════════════════════════════════════════════════════
# Project ORION — Production Environment Configuration Template
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env for local development or configure in your cloud
# provider dashboard (Render / AWS / GCP) for production deployments.
#
# NON-NEGOTIABLE SAFETY:
# - Project ORION operates strictly in PAPER SIMULATION MODE ($0 capital at risk).
# - Live trading endpoints (e.g. api-fxtrade.oanda.com) are rejected by BrokerEndpointValidator.
# - Live Stripe credentials (sk_live_...) are strictly rejected by BillingConfig.
# ══════════════════════════════════════════════════════════════════════════════

# ─── 1. Core Application & Server Runtime ────────────────────────────────────
ORION_ENV=production
ORION_LOG_LEVEL=INFO
ORION_SERVER_HOST=0.0.0.0
ORION_SERVER_PORT=8000
PORT=8000

# ─── 2. Database (PostgreSQL) ────────────────────────────────────────────────
# Production: Render Managed PostgreSQL connection string (asyncpg driver)
# Example: postgresql+asyncpg://user:password@hostname:5432/orion_prod
ORION_DATABASE_URL=postgresql+asyncpg://orion:orion@localhost:5432/orion_prod

# ─── 3. Migration Execution Control (EPIC-027 Phase 6B) ───────────────────────
# PRODUCTION: Must be "false" (migrations decoupled to Render preDeployCommand)
# LOCAL DEV:  May be set to "true" for automated in-lifespan migrations
ORION_RUN_MIGRATIONS=false

# ─── 4. In-Memory Cache & Coordination (Redis) ──────────────────────────────
# Used for sliding-window rate limiting, real-time market cache, and distributed locks.
# Example: redis://:password@hostname:6379/0 or rediss:// for TLS
ORION_REDIS_URL=redis://localhost:6379/0

# ─── 5. Security & JWT Authentication ────────────────────────────────────────
# Secret key for HS256 JWT signature verification (minimum 32 characters)
# In Render: Automatically generated via 'generateValue: true' in render.yaml
ORION_JWT_SECRET_KEY=change-this-to-a-secure-random-32-character-secret-key-in-production
ORION_JWT_ALGORITHM=HS256
ORION_JWT_EXPIRATION_MINUTES=60

# Telemetry authentication token protecting GET /metrics
ORION_METRICS_TOKEN=change-this-to-a-secure-metrics-bearer-token

# ─── 6. Autonomous Worker & Trading Safety Invariants ────────────────────────
# MUST remain "false" unless explicitly approved by institutional risk committee
ORION_WORKER_ENABLED=false
ORION_WORKER_SYMBOLS=EUR/USD,GBP/USD,USD/JPY
ORION_PAPER_BALANCE=100000.00
ORION_WORKER_STALE_THRESHOLD=30.0
ORION_MARKET_DATA_POLL_INTERVAL=5.0
ORION_TRADING_CYCLE_INTERVAL=10.0

# ─── 7. Market Data & Broker Practice Environment ────────────────────────────
# Only practice/sandbox endpoints are permitted (api-fxpractice.oanda.com)
ORION_MARKET_DATA_PROVIDER=mock
OANDA_ENVIRONMENT=practice
OANDA_PRACTICE_API_KEY=your-oanda-sandbox-token-here
OANDA_ACCOUNT_ID=your-oanda-sandbox-account-id-here

# ─── 8. Commercial Billing (Stripe Test Mode Only) ───────────────────────────
# STRICTLY TEST MODE: Keys starting with sk_live_ or pk_live_ will abort startup!
ORION_STRIPE_SECRET_KEY=sk_test_placeholder_key_here
ORION_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_here
ORION_STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret_here

# ─── 9. Transactional Email Dispatcher ───────────────────────────────────────
# Backend options: console, mock, smtp, ses
ORION_EMAIL_BACKEND=console
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-verified-domain.com
SMTP_PASSWORD=your-smtp-password-here
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=notifications@your-verified-domain.com

# ─── 10. CORS Ingress Controls ───────────────────────────────────────────────
# Comma-separated list of approved frontend origins allowed to communicate with API
ORION_CORS_ORIGINS=https://orion-dashboard.onrender.com,http://localhost:5173

# ─── 11. Off-site S3 Backup & Disaster Recovery ──────────────────────────────
# Used by backup/database-backup.sh for AES-256 encrypted off-site archives
BACKUP_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-for-openssl-aes-256
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=orion-production-backups
AWS_REGION=us-east-1
